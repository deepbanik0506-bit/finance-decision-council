# Backend environment (copy to .env for local development; set in Render for production).
# NEVER commit .env. These values must stay server-side.

# Required: Groq credentials used by the council agents.
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-20b

# Comma-separated browser origins allowed by CORS (no trailing slash).
# Production: your Vercel URL, e.g. https://<your-project>.vercel.app
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: regex for additional origins (e.g. Vercel preview deployments).
# ALLOWED_ORIGIN_REGEX=^https://<your-project>(-[a-z0-9-]+)?\.vercel\.app$

# Optional throttling (per-process, in-memory).
RATE_LIMIT_PER_MINUTE=5
MAX_CONCURRENT_ANALYSES=2

# Optional: set false to hide /docs and /openapi.json.
ENABLE_DOCS=true
LOG_LEVEL=INFO
