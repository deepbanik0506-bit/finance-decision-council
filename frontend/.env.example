# Public URL of the deployed FastAPI backend (no trailing slash).
# Required for production builds (Vercel). Example: https://<your-service>.onrender.com
# This value is embedded in browser code: NEVER put secrets in VITE_* variables.
VITE_API_BASE_URL=

# Development only: where `npm run dev` proxies /api and /health when
# VITE_API_BASE_URL is empty. Not used in production builds.
DEV_API_PROXY_TARGET=http://127.0.0.1:8000
